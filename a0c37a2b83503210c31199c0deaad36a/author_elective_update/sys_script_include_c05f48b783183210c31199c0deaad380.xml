        <api_name>x_1795292_learni_0.AgendaUtils</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description>Impede de criar o mesmo curso X pra mesma data X.</description>
        <mobile_callable>false</mobile_callable>
        <name>AgendaUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var AgendaUtils = Class.create();
AgendaUtils.prototype = Object.extendsObject(AbstractAjaxProcessor, {

    /**
     * Chamada via GlideAjax:
     * ga.addParam('sysparm_name','checkDuplicateAgenda');
     * ga.addParam('sysparm_course', courseSysId);
     * ga.addParam('sysparm_date', dateValue);
     *
     * Retorna 'true' ou 'false' (string).
     */
    checkDuplicateAgenda: function() {
        var course = this.getParameter('sysparm_course');
        var date = this.getParameter('sysparm_date');

        if (!course || !date)
            return 'false';

        var gr = new GlideRecordSecure('x_1795292_learni_0_agenda');
        gr.addQuery('title_course', course);

        // substitua 'course_date' pelo nome exato do campo de data na sua tabela Agenda
        gr.addQuery('course_date', date);

        gr.query();
        return (gr.hasNext()).toString(); // 'true' ou 'false'
    },

    type: 'AgendaUtils'
});
]]></script>
