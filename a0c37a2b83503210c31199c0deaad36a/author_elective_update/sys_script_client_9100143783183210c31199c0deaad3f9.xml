<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Impede de criar o mesmo curso X pra mesma data X.</description>
        <field>course_date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Same Course and Date check</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || !newValue) return;

    var course = g_form.getValue('title_course'); // Campo com o nome do curso na tabela agenda.
    var date = newValue; // ou g_form.getValue('course_date') checar

    if (!course) {
        g_form.showFieldMsg('title_course', 'Selecione um curso antes de escolher a data.', 'info');
        return;
    }

    var ga = new GlideAjax('AgendaUtils');
    ga.addParam('sysparm_name', 'checkDuplicateAgenda');
    ga.addParam('sysparm_course', course);
    ga.addParam('sysparm_date', date);
    ga.getXMLAnswer(function(answer) {
        if (answer === 'true') {
            g_form.showFieldMsg('course_date', '⚠️ Já existe um treinamento deste curso nesta data.', 'error');
            g_form.setValue('course_date', '');
        } else {
            // remove mensagem de erro caso já existisse
            g_form.hideFieldMsg('course_date', true);
        }
    });
}
]]></script>
